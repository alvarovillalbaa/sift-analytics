name: Anonymous hosted HTTP release observation
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: hosted-http-checks
  cancel-in-progress: false
jobs:
  hosted-http:
    if: github.repository == 'alvarovillalbaa/sift-analytics' && github.event.repository.private == false && github.ref == 'refs/heads/main' && github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      SOURCE_COMMIT: ${{ github.sha }}
    steps:
      - name: Define owned proof path without changing HOME
        shell: bash
        run: |
          proof_root="$RUNNER_TEMP/sift-hosted-http"
          mkdir -m 700 "$proof_root"
          nonce="$(openssl rand -hex 16)"
          printf %s "$nonce" > "$proof_root/.owner"
          chmod 600 "$proof_root/.owner"
          printf 'SIFT_HOSTED_HTTP_DIR=%s\nSIFT_HOSTED_HTTP_NONCE=%s\n' "$proof_root" "$nonce" >> "$GITHUB_ENV"
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          clean: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '24.22.2'
      - name: Record exact source before HTTP
        shell: bash
        run: |
          test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"
          test -z "$(git status --porcelain)"
          node tests/support/source-manifest.mjs "$SIFT_HOSTED_HTTP_DIR/source-before.json"
          node --check tests/support/hosted-http.mjs
      - name: One bounded anonymous HTTP packet without installs
        shell: bash
        run: node tests/support/hosted-http.mjs
      - name: Always verify unchanged source
        if: always()
        shell: bash
        run: |
          test -f "$SIFT_HOSTED_HTTP_DIR/source-before.json"
          node tests/support/source-manifest.mjs "$SIFT_HOSTED_HTTP_DIR/source-after.json"
          cmp "$SIFT_HOSTED_HTTP_DIR/source-before.json" "$SIFT_HOSTED_HTTP_DIR/source-after.json"
          git diff --exit-code HEAD --
          test -z "$(git status --porcelain)"
      - name: Retain bounded originals in readable logs
        if: always()
        shell: bash
        run: node tests/support/hosted-http.mjs --emit
      - name: Retain original public HTTP evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: hosted-http-observation
          path: ${{ runner.temp }}/sift-hosted-http
          include-hidden-files: false
          retention-days: 7
