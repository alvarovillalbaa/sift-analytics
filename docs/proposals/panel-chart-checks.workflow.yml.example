name: Temporary Sift panel chart checks
on:
  create:
permissions:
  contents: read
jobs:
  panel-chart:
    if: github.repository == 'alvarovillalbaa/sift-analytics' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/sift-panel-chart-20261111-2'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: APPROVED_SOURCE_COMMIT
      NEXT_TELEMETRY_DISABLED: '1'
      SIFT_BROWSER_SCOPE: panel-chart
    steps:
      - name: Define owned disposable paths
        shell: bash
        run: |
          task_root="$RUNNER_TEMP/sift-panel-chart"
          mkdir -m 700 "$task_root"
          started_ticks="$(python3 -c 'text = open("/proc/self/stat").read(); print(text[text.rfind(")") + 2:].split()[19])')"
          printf 'SIFT_IMPORT_START_TICKS=%s\n' "$started_ticks" >> "$GITHUB_ENV"
          nonce="$(openssl rand -hex 16)"
          printf %s "$nonce" > "$task_root/.owner"
          chmod 600 "$task_root/.owner"
          mkdir -m 700 "$task_root/proof" "$task_root/tmp" "$task_root/cache"
          printf 'SIFT_IMPORT_RUN_ROOT=%s\n' "$task_root" >> "$GITHUB_ENV"
          printf 'SIFT_IMPORT_NONCE=%s\n' "$nonce" >> "$GITHUB_ENV"
          printf 'SIFT_IMPORT_PROOF_DIR=%s\n' "$task_root/proof" >> "$GITHUB_ENV"
          printf 'SIFT_IMPORT_PLAYWRIGHT_DIR=%s\n' "$task_root/tools" >> "$GITHUB_ENV"
          printf 'PLAYWRIGHT_BROWSERS_PATH=%s\n' "$task_root/browser-binaries" >> "$GITHUB_ENV"
          printf 'npm_config_cache=%s\n' "$task_root/cache" >> "$GITHUB_ENV"
          printf 'TMPDIR=%s\nTEMP=%s\nTMP=%s\n' "$task_root/tmp" "$task_root/tmp" "$task_root/tmp" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          fetch-depth: 1
          clean: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '24.22.2'
      - name: Bind source and check focused syntax
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"
          git diff --exit-code HEAD --
          test -z "$(git status --porcelain)"
          node tests/support/source-manifest.mjs "$SIFT_IMPORT_PROOF_DIR/source-before.json"
          node --check tests/e2e/panel-chart.spec.mjs
          node --check tests/support/run-browser.mjs
          node --check tests/support/emit-proof.mjs
          git diff --check
      - name: Install the frozen app and build production
        timeout-minutes: 5
        shell: bash
        run: |
          set -euo pipefail
          npm ci --ignore-scripts --no-audit --no-fund 2>&1 | tee "$SIFT_IMPORT_PROOF_DIR/install.log"
          node scripts/copy-duckdb.mjs
          npm run build 2>&1 | tee "$SIFT_IMPORT_PROOF_DIR/build.log"
      - name: Install pinned isolated Chromium tools
        timeout-minutes: 3
        shell: bash
        run: |
          set -euo pipefail
          npm install --prefix "$SIFT_IMPORT_PLAYWRIGHT_DIR" --ignore-scripts --omit=optional --no-audit --no-fund playwright@1.65.0 2>&1 | tee "$SIFT_IMPORT_PROOF_DIR/tools-install.log"
          node --input-type=module <<'JS'
          import { readFile, writeFile } from 'node:fs/promises';
          const raw = await readFile(`${process.env.SIFT_IMPORT_PLAYWRIGHT_DIR}/package-lock.json`);
          const lock = JSON.parse(raw);
          const expected = {
            playwright: 'sha512-F3AMWcR44qMBt4kq+6Kb6mX7bjGXshktKFOPULd7reED6ZJWevjbNRqysP7q+AATE9kdPEZBibex1BYsvpVoeA==',
            'playwright-core': 'sha512-vNSKgH6YqtN7cdT/L334zo0a+YwkrpicyrHJlWWPIm/Q+Nn2SWInil01oT0mbu96U4GgoRtCYQD9CzJQgju+lA=='
          };
          for (const [name, integrity] of Object.entries(expected)) {
            const entry = lock.packages[`node_modules/${name}`];
            if (entry?.version !== '1.65.0' || entry.integrity !== integrity) throw new Error(`Browser identity mismatch: ${name}`);
          }
          await writeFile(`${process.env.SIFT_IMPORT_PROOF_DIR}/tools-lock.json`, raw, { flag: 'wx' });
          JS
          "$SIFT_IMPORT_PLAYWRIGHT_DIR/node_modules/.bin/playwright" install chromium 2>&1 | tee -a "$SIFT_IMPORT_PROOF_DIR/tools-install.log"
      - name: Four native chart-rendering journeys
        timeout-minutes: 7
        shell: bash
        run: node tests/support/run-browser.mjs
      - name: Always bind unchanged final source
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          test -f "$SIFT_IMPORT_PROOF_DIR/source-before.json"
          node tests/support/source-manifest.mjs "$SIFT_IMPORT_PROOF_DIR/source-after.json"
          cmp "$SIFT_IMPORT_PROOF_DIR/source-before.json" "$SIFT_IMPORT_PROOF_DIR/source-after.json"
          git diff --exit-code HEAD --
          test -z "$(git status --porcelain)"
      - name: Retain bounded originals in readable logs
        if: always()
        shell: bash
        run: node tests/support/emit-proof.mjs
      - name: Retain original source and runtime evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: panel-chart-checks-${{ github.run_id }}
          path: ${{ runner.temp }}/sift-panel-chart/proof
          retention-days: 1
