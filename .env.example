# Required in production. Generate a unique random value of at least 32 characters.
SIFT_SESSION_SECRET=

# Required for AI Gateway outside Vercel. Vercel uses project OIDC.
AI_GATEWAY_API_KEY=

# Optional canonical frontend origin; same-origin requests work without this.
SIFT_APP_ORIGIN=

# Optional private PostgreSQL adapter. Use a dedicated SELECT-only database role.
SIFT_ACCESS_TOKEN=
SIFT_POSTGRES_CONNECTIONS=[]
